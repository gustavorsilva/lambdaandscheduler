WITH base AS (
    SELECT
        DATE_TRUNC('month', DATA)   AS mes,
        TAG,
        UNICOS,
        IMPACTOS
    FROM sua_tabela
    WHERE GRANULARIDADE = 'dia-dia'       -- exclui linhas do tipo 'mes' (GERAL_MES)
      AND REGISTRO      = 'Jornada'       -- evita duplicidade com Jornada_Subjornada
)

SELECT
    TO_CHAR(mes, 'MM/YYYY')                                     AS mes_ano,
    TAG,

    -- Maior valor de únicos registrado no mês para a TAG
    MAX(UNICOS)                                                  AS max_unicos,

    -- Total de impactos no mês por TAG
    SUM(IMPACTOS)                                                AS total_impactos,

    -- % Impacto Ponderado = Σ Impactos / Σ Únicos
    ROUND(
        SUM(IMPACTOS)::NUMERIC / NULLIF(SUM(UNICOS), 0) * 100
    , 2) || '%'                                                  AS perc_impacto_ponderado

FROM base
GROUP BY
    mes,
    TAG
ORDER BY
    mes,
    TAG;
